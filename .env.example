# Google Cloud Vision API key. Create it only in Vercel Project Settings.
GOOGLE_VISION_API_KEY=replace-with-server-side-api-key

# Optional. Comma-separated origins allowed to call /api/ocr cross-origin.
# Same-origin Vercel deployments do not need this.
OCR_ALLOWED_ORIGINS=https://roubizhao6-sys.github.io
