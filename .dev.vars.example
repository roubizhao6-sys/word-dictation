# Local only. Copy to .dev.vars and do not commit that file.
# Production:
#   npx wrangler secret put BAIDU_OCR_API_KEY
#   npx wrangler secret put BAIDU_OCR_SECRET_KEY
BAIDU_OCR_API_KEY=replace-with-baidu-api-key
BAIDU_OCR_SECRET_KEY=replace-with-baidu-secret-key
# Optional. true/1/yes/on calls 手写文字识别 instead of 高精度含位置版.
# BAIDU_OCR_HANDWRITING=true
