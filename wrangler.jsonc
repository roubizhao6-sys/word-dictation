{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "word-dictation-ocr",
  "main": "src/index.js",
  // Keep this current when upgrading the Worker runtime.
  "compatibility_date": "2026-10-30",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  // Public allowlist. No path and no trailing slash. Comma-separated.
  // GitHub Pages, the mainland site (tingxieyou.cn), and its IP origin.
  // `wrangler secret put OCR_ALLOWED_ORIGINS` overrides this var on deploy.
  "vars": {
    "OCR_ALLOWED_ORIGINS": "https://roubizhao6-sys.github.io,http://120.77.70.33,http://tingxieyou.cn,https://tingxieyou.cn,http://www.tingxieyou.cn,https://www.tingxieyou.cn"
  },
  // Values are set with `wrangler secret put`, never written here.
  // BAIDU_OCR_API_KEY is the Baidu app API Key; BAIDU_OCR_SECRET_KEY is its Secret Key.
  "secrets": {
    "required": ["BAIDU_OCR_API_KEY", "BAIDU_OCR_SECRET_KEY"]
  }
}
